{
  "name": "github-app-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "cdk": "cdk",
    "deploy": "cdk deploy -c environment=dev --profile admin --require-approval never",
    "format": "biome check . --write",
    "lint": "biome check .",
    "synth": "cdk synth -c environment=dev --profile admin",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-lambda-powertools/commons": "^2.34.0",
    "@aws-lambda-powertools/idempotency": "^2.34.0",
    "@aws-lambda-powertools/logger": "^2.34.0",
    "@aws-lambda-powertools/metrics": "^2.34.0",
    "@aws-lambda-powertools/parameters": "^2.34.0",
    "@aws-lambda-powertools/parser": "^2.34.0",
    "@aws-sdk/client-eventbridge": "^3.1118.0",
    "aws-cdk-lib": "^2.266.0",
    "constructs": "^10.8.1",
    "octokit": "^5.0.3",
    "source-map-support": "^0.5.21",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "aws-cdk": "^2.1138.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
